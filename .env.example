# Server-only values. Never prefix these with VITE_.
TELLA_API_KEY=
TELLA_API_BASE_URL=https://api.tella.com/v1

# Server-only Claude subscription credential. Never prefix this with VITE_.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional local API port.
PORT=3001

# Application log level: fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=info

# Absolute path to the Google service account JSON key file.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_MONDAY_CLIENT_NOTES_SPREADSHEET_ID=
GOOGLE_SUNDAY_CLIENT_NOTES_SPREADSHEET_ID=
